# ═══════════════════════════════════════════════════════════════════════════
# SISTEMA DE GESTÃO INTEGRADO - ARQUIVO DE CONFIGURAÇÃO
# ═══════════════════════════════════════════════════════════════════════════
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env (não será versionado)
# 2. Preencha os valores com suas credenciais
# 3. Nunca compartilhe este arquivo ou seu token
#
# ═══════════════════════════════════════════════════════════════════════════

# TELEGRAM BOT TOKEN
# Obtenha em: @BotFather no Telegram
# Comando: /newbot
# Formato: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=seu_token_aqui

# ADMIN IDs
# Seu ID de usuário no Telegram
# Obtenha em: @userinfobot -> /start
# Se múltiplos admins, separe por vírgula
# Formato: 123456789,987654321,111222333
ADMIN_IDS=seu_id_aqui

# ═══════════════════════════════════════════════════════════════════════════
# EXEMPLOS
# ═══════════════════════════════════════════════════════════════════════════
#
# TELEGRAM_BOT_TOKEN=5432199876:ABCDefGhIjKlMnOpQrStUvWxYz123456
# ADMIN_IDS=123456789,987654321
#
# ═══════════════════════════════════════════════════════════════════════════
